# .env
HA_BASE_URL=http://localhost:8123
HA_TOKEN=your_long_lived_token_here
HA_ENTITY_IDS=light.living_room,switch.fan,binary_sensor.front_door

PORT=3001

# Syncthing — API key is read from the mounted config.xml; set this only to override
# SYNCTHING_API_KEY=
SYNCTHING_FOLDER=Albyte (Obsidian)

# Humidors — Govee sensors from HA (entity_id regex) and target ranges
# HUMIDOR_MATCH=^sensor\.h5\d{3}_[0-9a-f]+_
# HUMIDOR_RH_MIN=62
# HUMIDOR_RH_MAX=72
# HUMIDOR_TEMP_MIN=16
# HUMIDOR_TEMP_MAX=21
# HUMIDOR_STALE_MIN=30

# Optional qBittorrent WebUI creds for speed/torrent stats (names match "auth" in services.json)
# RASPI_QBIT_USER=
# RASPI_QBIT_PASS=
# ROCKY_QBIT_USER=
# ROCKY_QBIT_PASS=

# Betbot panel and /betbot/ proxy — betbot-dashboard's loopback port
# BETBOT_URL=http://127.0.0.1:8171

# HTTPS address from `tailscale serve`; old :3001 links redirect here
PUBLIC_URL=https://raspi.<tailnet>.ts.net
